#
# _fsh_state hash serves as container for variables that
# prevents creating them in global scope. (P) flag is not used,
# output array is fixed (_fsh_command_output).
#
# $1 - the command, e.g. "git remote"; 2>/dev/null redirection is
#      added automatically
# $2 - _fsh_state field name, e.g. "chroma-git-branches"; two
#      additional fields will be used, $2-cache, $2-cache-born-at
# $3 - what to remove from beginning of the lines returned by the
#      command
# $4 - cache validity time, default 5 (seconds)
#
# Output: array _fsh_command_output, with output of the command run

# User should not forget to define this array, the below code
# will only ensure that it's array (can also define a global)
builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd

typeset -ga _fsh_command_output
local -a __response

if [[ -z "${_fsh_state[$2-cache]}" || $(( EPOCHSECONDS - _fsh_state[$2-cache-born-at] )) -gt ${4:-5} ]]; then
  _fsh_state[$2-cache-born-at]="$EPOCHSECONDS"
  __response=( ${${(f)"$(command ${(Qz)1#+} 2>/dev/null)"}#${~3}} )
  [[ "$1" = "+"* ]] && _fsh_command_output+=( "${__response[@]}" ) || _fsh_command_output=( "${__response[@]}" )
  _fsh_state[$2-cache]="${(j:;:)__response}"
else
  # Quoted (s:;:) flag without @ will skip empty elements. It
  # still produces array output, interestingly. All this is for
  # the trailing ";" above, to skip last, empty element.
  [[ "$1" = "+"* ]] && \
    _fsh_command_output+=( "${(@s:;:)_fsh_state[$2-cache]}" ) || _fsh_command_output=( "${(@s:;:)_fsh_state[$2-cache]}" )
fi
