# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et

builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd no_nomatch

(( next_word = 2 | 8192 ))
[[ "$__arg_type" = 3 ]] && return 2
local __first_call=$1 __wrd=$2 __start_pos=$3 __end_pos=$4
local __style key
local -a _fsh_command_output

(( __first_call || in_redirection > 0 || this_word & 128 )) && return 1
[[ $__wrd == -* || $__wrd == "<<<" ]] && return 1
(( ${+commands[whatis]} )) || return 1

key="chroma-whatis-${(q)MANPATH}-${(q)__wrd}"
# man-db uses 16 for no match; mandoc reports a successful empty result.
_fsh_state[$key-success-statuses]="0 16"
_fsh_async_command "$key" env LC_ALL=C whatis "$__wrd"
__style=${_fsh_theme_name}default
if (( ${_fsh_state[$key-cache-ready]:-0} )); then
  if [[ -n ${_fsh_command_output[1]-} && ${_fsh_command_output[1]} != *"nothing appropriate"* ]] &&
      (( ${_fsh_state[$key-cache-status]:-0} == 0 )); then
    __style=${_fsh_theme_name}correct-subtle
  elif [[ ${~__wrd} == */* && -e ${~__wrd} ]]; then
    __style=${_fsh_theme_name}path
  else
    __style=${_fsh_theme_name}incorrect-subtle
  fi
fi

(( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER}, __start >= 0 )) &&
  reply+=("$__start $__end ${_fsh_styles[$__style]}")
(( this_word = next_word ))
_start_pos=$4
return 0
