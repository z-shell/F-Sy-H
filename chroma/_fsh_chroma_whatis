# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et

builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd no_nomatch

(( next_word = 2 | 8192 ))
local THEFD check __first_call="$1" __wrd="$2" __start_pos="$3" __end_pos="$4"
local __style

(( ! ${+_fsh_state[whatis_chroma_callback_was_ran]} )) && \
  _fsh_state[whatis_chroma_callback_was_ran]=0

(( ! ${+_fsh_state[whatis_chroma_zle_-F_have_-w_opt]} )) && {
  is-at-least 5.0.6 && local __res=1 || local __res=0
  _fsh_state[whatis_chroma_zle_-F_have_-w_opt]="$__res"
}

_fsh_chroma_whatis_callback() {
  builtin emulate -L zsh ${=${options[xtrace]:#off}:+-o xtrace}
  builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd

  local THEFD="$1" input check=2 nl=$'\n' __wrd __style

  _fsh_read_all "$THEFD" input

  zle -F "$THEFD"
  exec {THEFD}<&-
  _fsh_lifecycle_release_fd "$THEFD"

    __wrd="${${input#[^$nl]#$nl}%%$nl*}"
    if [[ "$input" = test* ]]; then
        if [[ "${input%$nl}" = *[^0-9]'0' ]]; then
            if [[ "${input#test$nl}" = *nothing\ appropriate* ]]; then
                _fsh_state[whatis_chroma_type]=2
            else
                _fsh_state[whatis_chroma_type]=0
            fi
        else
            _fsh_state[whatis_chroma_type]=1
        fi
    elif [[ "$input" = type2* ]]; then
        [[ "$input" != *nothing\ appropriate* ]] && check=1 || check=0
    elif [[ "$input" = type1* ]]; then
        [[ "${input%$nl}" = *0 ]] && check=1 || check=0
    fi

    if (( check != 2 )); then
        _fsh_state[whatis-cache-$__wrd]=$check
        if (( check )) then
            __style=${_fsh_styles[${_fsh_theme_name}correct-subtle]}
        elif [[ ${~__wrd} = */* && -e ${~__wrd} ]] then
            __style=${_fsh_styles[${_fsh_theme_name}path]}
        else
            __style=${_fsh_styles[${_fsh_theme_name}incorrect-subtle]}
        fi
        local -a start_end
        start_end=( ${(s:/:)${${(M)${${input#type?${nl}[^$nl]#$nl}}#*$nl}%$nl}} )
        (( start_end[1] >= 0 )) && region_highlight+=("$start_end[1] $start_end[2] $__style")
        zle -R
    fi

    _fsh_state[whatis_chroma_callback_was_ran]=1
    return 0
}

zle -N -- _fsh_chroma_whatis_callback

if (( __first_call )) && [[ -z "${_fsh_state[whatis_chroma_type]}" ]] ;then
    if ! command -v whatis > /dev/null; then
        _fsh_state[whatis_chroma_type]=0
        return 1
    fi

    exec {THEFD}< <(
        print "test"
        LANG=C whatis "osx whatis fallback check"
        print "$?"
    )
    command true # a workaround of Zsh bug
    if (( _fsh_state[whatis_chroma_zle_-F_have_-w_opt] )); then
        zle -F -w "$THEFD" _fsh_chroma_whatis_callback
    else
        zle -F "$THEFD" _fsh_chroma_whatis_callback
    fi
    _fsh_lifecycle_register_fd "$THEFD" _fsh_chroma_whatis_callback \
      "${sysparams[procsubstpid]-}"
fi

[[ "$__arg_type" = 3 ]] && return 2

if (( in_redirection > 0 || this_word & 128 )) || [[ $__wrd == "<<<" ]]; then
    return 1
fi

if (( __first_call )) || [[ "$__wrd" = -* ]]; then
    return 1
elif (( ! _fsh_state[whatis_chroma_type] )); then
    # Return 1 (i.e. treat the argument as a path) only if the callback have
    # had a chance to establish the whatis_chroma_type field
    (( _fsh_state[whatis_chroma_callback_was_ran] )) && return 1
else
    if [[ -z "${_fsh_state[whatis-cache-$__wrd]}" ]]; then
        if (( _fsh_state[whatis_chroma_type] == 2 )); then
            exec {THEFD}< <(
                print "type2"
                print "$__wrd"
                (( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER} ))
                print "$__start/$__end"
                LANG=C whatis "$__wrd" 2>/dev/null
            )
            command true # see above
            if (( _fsh_state[whatis_chroma_zle_-F_have_-w_opt] )); then
                zle -F -w "$THEFD" _fsh_chroma_whatis_callback
            else
                zle -F "$THEFD" _fsh_chroma_whatis_callback
            fi
            _fsh_lifecycle_register_fd "$THEFD" _fsh_chroma_whatis_callback \
              "${sysparams[procsubstpid]-}"
        else
            exec {THEFD}< <(
                print "type1"
                print "$__wrd"
                (( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER} ))
                print "$__start/$__end"
                LANG=C whatis "$__wrd" &> /dev/null
                print "$?"
            )
            command true
            if (( _fsh_state[whatis_chroma_zle_-F_have_-w_opt] )); then
                zle -F -w "$THEFD" _fsh_chroma_whatis_callback
            else
                zle -F "$THEFD" _fsh_chroma_whatis_callback
            fi
            _fsh_lifecycle_register_fd "$THEFD" _fsh_chroma_whatis_callback \
              "${sysparams[procsubstpid]-}"
        fi
        __style=${_fsh_styles[${_fsh_theme_name}incorrect-subtle]}
        (( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER}, __start >= 0 )) && \
            reply+=("$__start $__end $__style")
    else
        check=${_fsh_state[whatis-cache-$__wrd]}
        if (( check )) then
            __style=${_fsh_styles[${_fsh_theme_name}correct-subtle]}
        elif [[ ${~__wrd} = */* && -e ${~__wrd} ]] then
            __style=${_fsh_styles[${_fsh_theme_name}path]}
        elif (( _fsh_state[whatis_chroma_type] )); then
            __style=${_fsh_styles[${_fsh_theme_name}incorrect-subtle]}
        fi
        [[ -n "$__style" ]] && \
            (( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER}, __start >= 0 )) && \
                reply+=("$__start $__end $__style")
    fi
fi
(( this_word = next_word ))
_start_pos=$_end_pos

return 0
