# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et

builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd no_nomatch

(( next_word = 2 | 8192 ))
[[ "$__arg_type" = 3 ]] && return 2

local __first_call="$1" __wrd="${(Q)2}" __start_pos="$3" __end_pos="$4"
local __style

if (( __first_call )); then
  _fsh_state[chroma-fsh_theme-first]=0
  return 1
elif (( in_redirection > 0 || this_word & 128 )) || [[ $__wrd == "<<<" ]]; then
  return 1
elif (( ${_fsh_state[chroma-fsh_theme-first]} )) || [[ $__wrd = -* ]]; then
  return 1
else
  _fsh_state[chroma-fsh_theme-first]=1
fi

if [[ "$__wrd" = */* || "$__wrd" = (CONFIG|CACHE|LOCAL|HOME|OPT):* ]]; then
  __wrd="${${__wrd/(#s)CONFIG:/${${XDG_CONFIG_HOME:-$HOME/.config}%/}/f-sy-h/}%.ini}.ini"
  __wrd="${${__wrd/(#s)CACHE:/${${XDG_CACHE_HOME:-$HOME/.cache}%/}/f-sy-h/}%.ini}.ini"
  __wrd="${${__wrd/(#s)LOCAL://usr/local/share/f-sy-h/}%.ini}.ini"
  __wrd="${${__wrd/(#s)HOME:/$HOME/.f-sy-h/}%.ini}.ini"
  __wrd="${${__wrd/(#s)OPT://opt/local/share/f-sy-h/}%.ini}.ini"
  __wrd=${~__wrd} # allow user to quote ~
else
  __wrd="$_fsh_base_dir/themes/$__wrd.ini"
fi

if [[ -f $__wrd ]]; then
  __style=${_fsh_theme_name}path
else
  __style=${_fsh_theme_name}incorrect-subtle
fi

(( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER}, __start >= 0 )) \
  && reply+=("$__start $__end ${_fsh_styles[$__style]}")
(( this_word = next_word ))
_start_pos=$_end_pos

return 0
