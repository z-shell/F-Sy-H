# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et
#
# Chroma function for command `zi'. It colorizes the part of command line that holds `zi' invocation.

builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd no_nomatch

(( _fsh_state[chroma-zi-definition] )) && return 1

_fsh_state[chroma-zi-definition]=1

# Canonical list of `zi' subcommands lives in zi's own ZI[cmd-list] (zi.zsh);
# read it here instead of hand-maintaining a second copy that silently drifts
# (e.g. #31, and the `version' subcommand added in z-shell/zi@b8248aa never
# reaching this file). The literal fallback below is a frozen snapshot for
# the rare case this chroma loads before `zi' has populated $ZI.
local __zi_subcommands="${ZI[cmd-list]:-help|subcmds|icemods|analytics|man|self-update|times|zstatus|load|light|unload|snippet|ls|ice|<ice|specification>|update|status|report|delete|loaded|list|cd|create|edit|glance|stress|changes|recently|clist|completions|cclear|cdisable|cenable|creinstall|cuninstall|csearch|compinit|dtrace|dstart|dstop|dunload|dreport|dclear|compile|uncompile|compiled|cdlist|cdreplay|cdclear|srv|recall|env-whitelist|bindkeys|module|add-fpath|run}"

typeset -gA _fsh_chroma_zi_def
_fsh_chroma_zi_def=(
    ##
    ## No subcommand
    ##
    ## {{{

    subcmd:NULL "NULL_0_opt"
    NULL_0_opt "(-help|--help|-h)
                   <<>> NO-OP // ::_fsh_chroma_option_action"
    "subcommands" "(${__zi_subcommands})"

    ## }}}

    # Generic actions
    NO_MATCH_\#_opt "* <<>> __style=\${_fsh_theme_name}incorrect-subtle // NO-OP"
    NO_MATCH_\#_arg "__style=\${_fsh_theme_name}incorrect-subtle // NO-OP"


    ##
    ## `ice'
    ##
    ## {{{

    subcmd:ice "ICE_#_arg // NO_MATCH_#_opt"

    "ICE_#_arg" "NO-OP // ::_fsh_chroma_zi_check_ice_modifier"

    ##
    ## `snippet'
    ##
    ## {{{

    subcmd:snippet "SNIPPET_0_opt // SNIPPET_1_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    SNIPPET_0_opt "(-h|--help|-f|--force|--command|-x)
                        <<>> NO-OP // ::_fsh_chroma_option_action"

    SNIPPET_1_arg "NO-OP // ::_fsh_chroma_zi_verify_snippet"

    ## }}}

    ##
    ## `load'
    ##
    ## {{{

    "subcmd:load" "LOAD_1_arg // LOAD_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    LOAD_1_arg "NO-OP // ::_fsh_chroma_zi_verify_plugin"

    LOAD_2_arg "NO-OP // ::_fsh_chroma_zi_verify_plugin"

    ## }}}

    ##
    ## `compile|uncompile|stress|edit|glance|recall|status|cd|changes`
    ##
    ## {{{

    "subcmd:(compile|uncompile|stress|edit|glance|recall|status|cd|changes)"
        "PLGSNP_1_arg // PLGSNP_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    PLGSNP_1_arg "NO-OP // ::_fsh_chroma_zi_verify_plugin_or_snippet"

    PLGSNP_2_arg "NO-OP // ::_fsh_chroma_zi_verify_plugin_or_snippet"

    ## }}}

    ##
    ## `update'
    ##
    ## {{{

    subcmd:update "UPDATE_0_opt // PLGSNP_1_arg // PLGSNP_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    UPDATE_0_opt "
            (-L|--plugins|-s|--snippets|-p|--parallel|-a|--all|-q|--quiet|-r|--reset|-u|--urge|-n|--no-pager|-v|--verbose|-h|--help)
                    <<>> NO-OP // ::_fsh_chroma_option_action"

    ## }}}

    ##
    ## `light'
    ##
    ## {{{

    subcmd:light "LIGHT_0_opt // LOAD_1_arg // LOAD_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    LIGHT_0_opt "-h|--help|-b
                    <<>> NO-OP // ::_fsh_chroma_option_action"

    ## }}}

    ##
    ## `unload'
    ##
    ## {{{

    subcmd:unload "UNLOAD_0_opt // UNLOAD_1_arg // UNLOAD_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    UNLOAD_0_opt "-h|--help|-q|--quiet
                    <<>> NO-OP // ::_fsh_chroma_option_action"

    UNLOAD_1_arg "NO-OP // ::_fsh_chroma_zi_verify_loaded_plugin"

    UNLOAD_2_arg "NO-OP // ::_fsh_chroma_zi_verify_loaded_plugin"

    ## }}}

    ##
    ## `report'
    ##
    ## {{{

    subcmd:report "REPORT_0_opt // UNLOAD_1_arg // UNLOAD_2_arg // NO_MATCH_#_opt //
                  NO_MATCH_#_arg"

    REPORT_0_opt "--all
                    <<>> NO-OP // ::_fsh_chroma_option_action"

    ## }}}

    ##
    ## `delete'
    ##
    ## {{{

    "subcmd:delete"
        "DELETE_0_opt // PLGSNP_1_arg // PLGSNP_2_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    DELETE_0_opt "
            (-a|--all|-c|--clean|-y|--yes|-q|--quiet|-h|--help)
                    <<>> NO-OP // ::_fsh_chroma_option_action"

    ## }}}

    ##
    ## `cenable'
    ##
    ## {{{

    subcmd:cenable "COMPLETION_1_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    COMPLETION_1_arg "NO-OP // ::_fsh_chroma_zi_verify_disabled_completion"

    ## }}}

    ##
    ## `cdisable'
    ##
    ## {{{

    subcmd:cdisable "DISCOMPLETION_1_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    DISCOMPLETION_1_arg "NO-OP // ::_fsh_chroma_zi_verify_completion"

    ## }}}


    ##
    ## `uncompile'
    ##
    ## {{{

    subcmd:uncompile "UNCOMPILE_1_arg // NO_MATCH_#_opt // NO_MATCH_#_arg"

    UNCOMPILE_1_arg "NO-OP // ::_fsh_chroma_zi_verify_compiled_plugin"

    ## }}}

    ##
    ## `*'
    ##
    ## {{{

    "subcmd:*" "CATCH_ALL_#_opt"
    "CATCH_ALL_#_opt" "* <<>> NO-OP // ::_fsh_chroma_option_separator_action"

    ## }}}
)

