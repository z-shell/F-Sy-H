# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et
#
# Tracks autoload command - highlights function names if they exist somewhere
# in $fpath. Also warns that the autoload function is already defined.
#
# $1 - 0 or 1, denoting if it's first call to the chroma, or following one
#
# $2 - the current token, also accessible by $__arg from the above scope -
#      basically a private copy of $__arg; the token can be eg.: "grep"
#
# $3 - a private copy of $_start_pos, i.e. the position of the token in the
#      command line buffer, used to add region_highlight entry (see man),
#      because Zsh colorizes by *ranges* in command line buffer
#
# $4 - a private copy of $_end_pos from the above scope
#

builtin emulate -L zsh
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd no_nomatch

(( next_word = 2 | 8192 ))

local __first_call="$1" __wrd="$2" __start_pos="$3" __end_pos="$4"
local __style __chars
integer __idx1 __idx2
local -a __results __deserialized __noshsplit

# First call, i.e. command starts, i.e. "grep" token etc.
(( __first_call )) && {
  _fsh_state[chroma-autoload-counter]=0
  _fsh_state[chroma-autoload-counter-all]=1
  _fsh_state[chroma-autoload-message]=""
  #_fsh_state[chroma-autoload-message-shown]=""
  [[ -z ${_fsh_state[chroma-autoload-message-shown-at]} ]] && _fsh_state[chroma-autoload-message-shown-at]=0
  _fsh_state[chroma-autoload-elements]=""
  __style=${_fsh_theme_name}command

} || {
  if (( in_redirection > 0 || this_word & 128 )) || [[ $__wrd == "<<<" ]]; then
    return 1
  fi
  (( _fsh_state[chroma-autoload-counter-all] += 1, __idx2 = _fsh_state[chroma-autoload-counter-all] ))

  # Following call, i.e. not the first one.

  # Check if chroma should end – test if token is of type
  # "starts new command", if so pass-through – chroma ends
  [[ "$__arg_type" = 3 ]] && return 2

  if [[ "$__wrd" = [-+]* ]]; then
    # Detected option, add style for it.
    [[ "$__wrd" = --* ]] && __style=${_fsh_theme_name}double-hyphen-option || \
      __style=${_fsh_theme_name}single-hyphen-option
  else
    # Count non-option tokens.
    (( _fsh_state[chroma-autoload-counter] += 1, __idx1 = _fsh_state[chroma-autoload-counter] ))

    if [[ $__wrd != (\$|\"\$)* && $__wrd != (/|\"/|\'/)* && $__wrd != \`* ]]; then
      __results=( ${^fpath}/$__wrd(N) )
      __deserialized=( "${(Q@)${(z@)_fsh_state[chroma-fpath_peq-elements]}}" )
      __results+=( ${^__deserialized}/$__wrd(N) )
      [[ "${#__results}" -gt 0 ]] && {
        __style=${_fsh_theme_name}correct-subtle
        __deserialized=( "${(Q@)${(z@)_fsh_state[chroma-autoload-elements]}}" )
        [[ -z "${__deserialized[1]}" && ${#__deserialized} -eq 1 ]] && __deserialized=()
        # Cannot use ${abc:+"$abc"} trick with ${~...}, so handle most
        # cases of the possible shwordsplit through an additional array
        __noshsplit=( ${~__wrd} )
        __deserialized+=( "${(j: :)__noshsplit}" )
        _fsh_state[chroma-autoload-elements]="${(j: :)${(q@)__deserialized}}"
        # Make the function defined for big-loop's *main-type mechanism
        _fsh_command_type_cache[${(j: :)__noshsplit}]="function"
      } || __style=${_fsh_theme_name}incorrect-subtle
    fi

    if (( ${+functions[${(Q)__wrd}]} )); then
      _fsh_state[chroma-autoload-message]+="Warning: Function ${(Q)__wrd} already defined (e.g. loaded)"$'\n'
    fi
  fi

  # Display only when processing last autoload argument
  if (( ${#${(z)BUFFER}} == _fsh_state[chroma-autoload-counter-all] )); then
    # Display only if already shown message differs or when it timeouts
    if [[ ${_fsh_state[chroma-autoload-message]} != ${_fsh_state[chroma-autoload-message-shown]} || \
      $(( EPOCHSECONDS - _fsh_state[chroma-autoload-message-shown-at] )) -gt 7 ]]; then
        _fsh_state[chroma-autoload-message-shown]=${_fsh_state[chroma-autoload-message]}
        _fsh_state[chroma-autoload-message-shown-at]=$EPOCHSECONDS
        zle -M "${_fsh_state[chroma-autoload-message]}"
    fi
  fi
}

# Add region_highlight entry (via `reply' array).
#
# This is a common place of adding such entry, but any above code
# can do it itself and skip setting __style to disable this code.
[[ -n "$__style" ]] && \
  (( __start=__start_pos-${#PREBUFFER}, __end=__end_pos-${#PREBUFFER}, __start >= 0 )) && \
    reply+=("$__start $__end ${_fsh_styles[$__style]}")

# We aren't passing-through (no return 1 occurred), do obligatory things ourselves.
(( this_word = next_word ))
_start_pos=$_end_pos

return 0
